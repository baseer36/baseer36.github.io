# Naqsh Carpets - Hostinger (LiteSpeed/Apache). Generated by source/build.py - edit it there.
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On
# one canonical host: https + no www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://naqshcarpets.com%{REQUEST_URI} [L,R=301]
# /something/index.html -> /something/
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]
# retired product / collection pages (catalogue replaced by the client's real designs)
RewriteRule ^rugs/isfahan-medallion-hand-knotted-rug/?$ /collections/classic-rugs/ [R=301,L]
RewriteRule ^ar/rugs/isfahan-medallion-hand-knotted-rug/?$ /ar/collections/classic-rugs/ [R=301,L]
